{
  "name": "@investigator/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API — customer, investigator, admin and AI surfaces",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "typecheck:specs": "tsc -p tsconfig.spec.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "worker": "node dist/worker.main.js",
    "migration:generate": "drizzle-kit generate",
    "migration:run": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures:load": "tsx test/demo-data.ts",
    "knowledge:sync": "tsc --build && node dist/modules/knowledge/knowledge-sync.main.js",
    "openapi:metadata": "tsc --build && node dist/common/openapi/metadata.generator.main.js"
  },
  "dependencies": {
    "@investigator/auth": "workspace:*",
    "@investigator/i18n": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.0",
    "@node-rs/argon2": "2.2.1",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "2.11.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.3",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@investigator/ui-tokens": "workspace:*",
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.9.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.11",
    "magic-string": "0.30.21",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "vitest": "4.1.11"
  }
}
