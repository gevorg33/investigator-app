{
  "name": "@investigator/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API — customer, investigator, admin and AI surfaces",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "migration:generate": "drizzle-kit generate",
    "migration:run": "drizzle-kit migrate",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@node-rs/argon2": "2.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.3",
    "@types/node": "24.9.2",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "vitest": "4.1.11"
  }
}
