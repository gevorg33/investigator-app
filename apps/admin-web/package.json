{
  "name": "@investigator/admin-web",
  "version": "0.0.0",
  "private": true,
  "description": "Staff console (admin.) — separate origin per ADR-0002",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "NODE_ENV=production next build",
    "start": "next start --port 3002",
    "typecheck": "tsc --noEmit",
    "typecheck:specs": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "budget": "node ../../scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@investigator/i18n": "workspace:*",
    "@investigator/ui-tokens": "workspace:*",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.11"
  }
}
