# Copy to .env.local and fill in. Never commit a real env file — they are gitignored
# and the guard hook blocks reading them.
#
#   ./scripts/setup.sh   creates .env.local from this and generates SESSION_SECRET.
#
# REQUIRED — the API will not boot without these; they are validated at startup.
# LATER    — placeholders for tasks not yet built. Leave blank until then.

# ── REQUIRED ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Provisioned locally by Docker Compose (T-003).
# Non-default host ports on purpose: a Homebrew postgres/redis commonly owns 5432
# and 6379, and the container mapping silently loses to it.
#
# Two roles, on purpose (T-073, ADR-0011):
#   DATABASE_URL           — the runtime role the API connects as. Not a superuser, no BYPASSRLS,
#                            owns nothing, so row-level security applies to it. The API refuses
#                            to boot as anything else.
#   MIGRATION_DATABASE_URL — the owner, for migrations and test fixtures only. Never give it to
#                            the API process outside local development.
DATABASE_URL=postgres://investigator_app:investigator_app@localhost:5433/investigator_dev
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5433/investigator_dev
# Outside local development, the runtime role's password — set by
# scripts/set-app-role-password.sh after migrations, never committed.
APP_DB_PASSWORD=
REDIS_URL=redis://localhost:6380

# Generated by scripts/setup.sh — no external account needed.
SESSION_SECRET=

# Where verification and password-reset links point. The app origin, not the apex —
# session cookies are host-only on app. (ADR-0002).
APP_BASE_URL=http://localhost:3000

# ── LATER — Google OAuth (T-062) ────────────────────────────────────────────────
# ACTIONS-FOR-ME.md #1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# ── Cloudinary private media (T-008) ────────────────────────────────────────────
# ACTIONS-FOR-ME.md #4. Optional locally: without them every media operation refuses.
# Required in staging and production, where CLOUDINARY_FOLDER must end in /staging or
# /production. All assets are `authenticated`; see docs/architecture/media.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=investigator/development

# ── LATER — payments (Phase 5) ──────────────────────────────────────────────────
# Provider unresolved (plan.md §12); acceptance is a launch blocker (ADR-0009).
# ACTIONS-FOR-ME.md #3
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_PUBLISHABLE_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ── LATER — AI assistant (Phase 7) ──────────────────────────────────────────────
# ACTIONS-FOR-ME.md #4
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LATER — transactional email ─────────────────────────────────────────────────
# Separate sending domains for transactional vs newsletter (ADR-0002).
# ACTIONS-FOR-ME.md #5
MAIL_PROVIDER_API_KEY=
MAIL_FROM_ADDRESS=no-reply@mail.example.com

# ── LATER — observability ───────────────────────────────────────────────────────
# ACTIONS-FOR-ME.md #6
SENTRY_DSN=
