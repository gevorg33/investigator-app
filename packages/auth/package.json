{
  "name": "@investigator/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Shared auth primitives and the Actor type",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "typecheck:specs": "tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@investigator/types": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "5.0.1"
  }
}
