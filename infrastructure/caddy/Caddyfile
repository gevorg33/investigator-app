# Investigator platform — edge routing and TLS.
# Architecture: docs/architecture/ADR-0002-domain-architecture.md
# Working rules:  .claude/skills/domain-and-seo/SKILL.md
#
# Hostnames come from environment, so the same file serves every environment:
#   DOMAIN=mydomain.com  APP_HOST=app.mydomain.com
#   ADMIN_HOST=admin.mydomain.com  NEWS_HOST=news.mydomain.com
# The API builds its links from the same variables (the domain map in packages/config), so the
# edge and the code cannot disagree about a name. No hostname is written here (T-023).
#
# mail.{$DOMAIN} is intentionally absent. It is a sending domain (SPF/DKIM/DMARC),
# not an HTTP service. See infrastructure/caddy/dns-and-email.md.
{
	email {$ACME_EMAIL}
	# No trusted_proxies: Caddy is the first hop, so every X-Forwarded-For a request arrives with
	# was written by the client, and is replaced by the address Caddy saw. Trusting private ranges
	# kept a client's own entry whenever Docker relayed its connection from the bridge gateway —
	# seen in T-023's verification — so Caddy's access log recorded an address the client chose.
	# Set this only if a load balancer is ever put in front (docs/operations/client-address.md).
}

# ---------------------------------------------------------------------------
# Shared snippets
# ---------------------------------------------------------------------------

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
		-X-Powered-By
	}
}

(compression) {
	encode zstd gzip
}

# ---------------------------------------------------------------------------
# Marketing — the only indexable origin
# ---------------------------------------------------------------------------

{$DOMAIN} {
	import security_headers
	import compression

	# Long-lived immutable build assets.
	@static path /_next/static/* /fonts/* /images/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# HTML: short cache, revalidate. Keeps content edits visible quickly.
	@html not path /_next/static/* /fonts/* /images/*
	header @html Cache-Control "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"

	# Anything authenticated belongs on the app origin. These must never 200 here. Each goes to the
	# app's own route — /login and /register are the names people type, /sign-in and /sign-up the
	# ones the app serves.
	redir /login https://{$APP_HOST}/sign-in permanent
	redir /sign-in https://{$APP_HOST}/sign-in permanent
	redir /register https://{$APP_HOST}/sign-up permanent
	redir /sign-up https://{$APP_HOST}/sign-up permanent
	redir /dashboard https://{$APP_HOST}/ permanent
	redir /app / permanent

	reverse_proxy marketing-web:3000

	log {
		output file /var/log/caddy/marketing.log
		format json
	}
}

# Apex is canonical; www redirects permanently.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# ---------------------------------------------------------------------------
# Application — never indexed, API same-origin at /api
# ---------------------------------------------------------------------------

{$APP_HOST} {
	import security_headers
	import compression

	# Set at the edge so no application route can forget it.
	# robots.txt here ALLOWS crawling on purpose: a blocked crawler never sees
	# this header, and an externally linked URL could still be indexed.
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

	# Authenticated responses must never be cached by a shared cache; content-hashed build assets
	# may be, forever. The two matchers exclude each other, as marketing's do: an unmatched
	# `header` beside a matched one let no-store win on the assets too (T-023's verification).
	@static path /_next/static/* /fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	@dynamic not path /_next/static/* /fonts/*
	header @dynamic Cache-Control "no-store, private"

	# Same-origin API. This is what makes SameSite=Strict cookies viable. The client's address
	# travels in X-Forwarded-For, which Caddy sets and the API reads from its TRUSTED_PROXIES
	# (docs/operations/client-address.md).
	handle /api/* {
		reverse_proxy api:3001 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /ws* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy app-web:3000
	}

	log {
		output file /var/log/caddy/app.log
		format json
	}
}

# ---------------------------------------------------------------------------
# Staff console — separate origin so a staff session cookie is unreachable
# from the customer application (plan.md §1, ADR-0002, ADR-0004).
# ---------------------------------------------------------------------------

{$ADMIN_HOST} {
	import security_headers
	import compression

	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

	# Optional hardening the customer app could never have. Uncomment with a real
	# allowlist once the office/VPN ranges are known — see T-023.
	# @not_allowed not remote_ip 10.0.0.0/8 192.168.0.0/16
	# respond @not_allowed 403

	# As on app.: no shared cache for anything but the content-hashed assets.
	@static path /_next/static/* /fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	@dynamic not path /_next/static/* /fonts/*
	header @dynamic Cache-Control "no-store, private"

	# Same-origin API, same reasoning as app. Staff scope is enforced in the API.
	handle /api/* {
		reverse_proxy api:3001 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy admin-web:3000
	}

	log {
		output file /var/log/caddy/admin.log
		format json
	}
}

# ---------------------------------------------------------------------------
# Newsletter — public archive indexable, management is not
# ---------------------------------------------------------------------------

{$NEWS_HOST} {
	import security_headers
	import compression

	# Subscriber management is authenticated; keep it out of search.
	@private path /manage* /preferences* /unsubscribe* /admin*
	header @private X-Robots-Tag "noindex, nofollow"
	header @private Cache-Control "no-store, private"

	@archive not path /manage* /preferences* /unsubscribe* /admin*
	header @archive Cache-Control "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"

	reverse_proxy news-web:3000

	log {
		output file /var/log/caddy/news.log
		format json
	}
}
