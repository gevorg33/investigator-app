node_modules/

# This project uses pnpm (ADR/T-001). An npm lockfile at the root would break
# `pnpm install --frozen-lockfile` in CI. These are strays from `npx shadcn mcp init`
# and should be deleted from the working tree — see T-001.
package-lock.json
yarn.lock
dist/
build/
.next/
.expo/
coverage/

.env
.env.*
!.env.example
.env.local
*.pem
*.key
secrets/

.claude/settings.local.json
.claude/logs/*
!.claude/logs/.gitignore

.DS_Store
.idea/

# iCloud conflict copies: syncing the repo from iCloud Desktop duplicates files as
# "name 2.ts", "name 3.ts". They are not edits anyone made — they are copies of files that
# already exist, and inside src/ they break `tsc` (duplicate declarations), get executed by
# vitest when they end in .spec.ts, and are counted by the 100% coverage gate. 135 of them
# appeared during T-011 and had to be quarantined by hand.
#
# Ignoring them keeps them out of commits. It does not stop them breaking the local build —
# the real fix is moving the repository off iCloud Desktop (ACTIONS-FOR-ME).
* [0-9].*

# tsc emitting next to its sources. apps/api/test/ and src/ hold TypeScript only; compiled
# output belongs in dist/. When these appear, tsc can then refuse to overwrite its own inputs.
apps/api/src/**/*.js
apps/api/src/**/*.js.map
apps/api/src/**/*.d.ts
apps/api/src/**/*.d.ts.map
apps/api/test/**/*.js
apps/api/test/**/*.js.map
apps/api/test/**/*.d.ts
apps/api/test/**/*.d.ts.map

# Playwright MCP writes page snapshots and screenshots here during visual QA (T-039). Working
# files, not artifacts: a baseline that should be kept is committed deliberately elsewhere.
.playwright-mcp/

# Next.js regenerates this on every dev and build run, and it points at .next/types, which exists
# only after one. Committing it would make `pnpm typecheck` depend on a build having run.
apps/*/next-env.d.ts
